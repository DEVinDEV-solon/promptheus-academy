# PROMPTHEUS — Vorlage. Kopieren nach .env und anpassen.
# Die .env geht NIE ins Repo und wird NIE ausgeliefert (router.php: 403).

# Port des lokalen Servers. ADVOCAT belegt 8791 und 8795.
PU_PORT=8801

# ---------------------------------------------------------------- Tutor
# Die vier Tutor-Agenten laufen ueber die Claude-CLI. Ohne diese Angaben
# bleiben sie stumm — alle Kurse, Aufgaben und Pruefungen laufen trotzdem.
#
# Leer lassen, wenn `claude` im PATH liegt; dann wird sie dort gesucht.
PU_CLAUDE_BIN=

# Modell fuer die Tutoren.
PU_MODELL=claude-sonnet-5

# Nur setzen, wenn die CLI nicht ueber die uebliche Anmeldung laeuft.
# ACHTUNG: ANTHROPIC_API_KEY wird bewusst NICHT gelesen — die Uni soll ueber
# das Abo laufen und nicht ueber die API abrechnen.
CLAUDE_CODE_OAUTH_TOKEN=

# ---------------------------------------------------------------- OpenRouter
# Zweiter Weg zu einem Sprachmodell — ohne Claude-CLI, direkt ueber HTTPS.
#
# Der Schluessel gehoert HIERHIN und nirgendwo sonst: nicht in eine
# config.json, nicht in den Code, nicht ins Repo. Die .env ist gitignored und
# wird von router.php mit 403 abgewiesen.
#
# Ist der Schluessel gesetzt, nehmen die Tutoren diesen Weg (Einstellungen ›
# Tutor-KI: "Weg" auf auto). Ist er leer, laeuft alles ueber die CLI, und
# ohne beides bleiben die Tutoren stumm — Kurse, Aufgaben und Pruefungen
# laufen in jedem Fall weiter.
PU_OPENROUTER_API_KEY=

# Modell fuer den OpenRouter-Weg. Leer = Vorgabe aus srv/tutor.php.
PU_OPENROUTER_MODELL=

# Liste der vertrauenswuerdigen Zertifikats-Aussteller (ca-bundle.crt).
#
# Nur noetig, wenn der OpenRouter-Aufruf mit "unable to get local issuer
# certificate" endet: die PHP-Installation aus dem Windows-Paketverwalter
# bringt keine Liste mit. srv/tutor.php sucht die ueblichen Orte selbst ab
# (u. a. die von Git) — hier steht nur, was dort nicht gefunden wurde.
#
# Die Pruefung wird NICHT abgeschaltet. Ueber diese Verbindung geht ein
# API-Schluessel; eine ungepruefte TLS-Verbindung kann jeder im selben Netz
# mitlesen.
PU_CA_BUNDLE=

# --------------------------------------------------------------------------
# Spracheingabe (whisper.cpp) — nur noetig, wenn die Uni sie nicht selbst
# findet.
#
# PROMPTHEUS bringt whisper NICHT mit: ein Sprachmodell allein ist ueber ein
# Gigabyte. Gesucht wird der Reihe nach in werkzeuge/whisper/ im
# Programmordner, in den Nachbarprogrammen des Hauses (Advocat, VoiceVibe)
# und im PATH. Was gefunden wurde, steht in den Einstellungen unter Tutor-KI.
#
# Zum Nachinstallieren auf einem anderen Server: whisper-cli und ein
# ggml-*.bin nach werkzeuge/whisper/ legen — oder hier den Pfad eintragen.
#
# Die Aufnahme verlaesst den Rechner nie. Erkannt wird oertlich, und geloescht
# wird sofort danach.
PU_WHISPER_BIN=
PU_WHISPER_MODELL=
PU_FFMPEG_BIN=

# ── Die Verbindung zum Relay ───────────────────────────────────────────────
#
# Erst noetig, wenn registriert werden soll. Kurse 1 bis 6 laufen ohne.
#
# PU_RELAY_URL      die Adresse unseres Servers
# PU_VPS_SCHLUESSEL sein oeffentlicher Signaturschluessel (base64)
#
# Ohne den Schluessel wird keine Bescheinigung angenommen — eine
# Bescheinigung, die niemand prueft, ist eine Behauptung. Er wird mit dem
# Programm ausgeliefert; bei der ersten Registrierung nennt ihn der Server
# zusaetzlich, aber uebernommen wird er nur, solange hier nichts steht.
PU_RELAY_URL=
PU_VPS_SCHLUESSEL=
