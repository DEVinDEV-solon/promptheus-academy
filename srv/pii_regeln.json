            "text": "Wo du wohnst oder zur Schule gehst, bleibt privat.",
            "muster": "(?:[Ii]ch\\s+wohne\\s+in|[Ww]ohne\\s+in|[Ll]ebe\\s+in|[Kk]omme\\s+aus|[Bb]in\\s+aus|[Gg]ehe\\s+in\\s+(?:die|eine)\\s+[\\p{L}-]*[Ss]chule\\s+in|[Ss]chule\\s+in)\\s+(\\p{Lu}[\\p{L}-]+(?:\\s+\\p{Lu}[\\p{L}-]+)?)",
            "schalter": "u",
            "treffer": [
                "ich wohne in Ludwigsburg",
                "komme aus Bad Cannstatt",
                "Schule in Freiburg"
            ],
            "kein_treffer": [
