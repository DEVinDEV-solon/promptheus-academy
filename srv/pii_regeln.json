            "titel": "Keine Profile aus anderen Netzwerken",
            "text": "Namen bei Instagram, TikTok, Snapchat oder Discord führen zu dir. Lass sie weg.",
            "muster": "(?:(?<![\\p{L}\\p{N}.])(?:instagram|tiktok|snapchat|discord|facebook|youtube|twitch|x|twitter)\\.(?:com|gg|tv)\\/\\S+|(?<![\\p{L}\\p{N}.])(?:wa|t)\\.me\\/\\S+|(?<![\\p{L}\\p{N}._%+-])@[A-Za-z0-9_.]{3,30}(?![@\\p{L}\\p{N}]))",
            "schalter": "u",
            "treffer": [
                "folgt mir @nele_funke",
                "tiktok.com/@nele",
                "discord.gg/abcdef"
