        {
            "id": "schulname",
            "art": "hart",
            "titel": "Kein Schulname",
            "text": "Der Name deiner Schule macht dich findbar.",
            "muster": "(?:\\p{Lu}[\\p{L}]*(?:-\\p{Lu}[\\p{L}]*)*-(?:[Gg]ymnasium|[Rr]ealschule|[Gg]rundschule|[Gg]esamtschule|[Hh]auptschule|[Oo]berschule|[Ss]chule)|(?:Gymnasium|Realschule|Grundschule|Gesamtschule|Hauptschule|Werkrealschule|Oberschule|Förderschule|Gemeinschaftsschule)\\s+(?:in\\s+|am\\s+|an\\s+der\\s+)?\\p{Lu}[\\p{L}-]+)",
