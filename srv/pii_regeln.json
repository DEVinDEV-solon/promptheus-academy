            "titel": "Keine Namen",
            "text": "Echte Namen — deiner oder die von anderen — bleiben draußen. Nimm dein Synonym.",
            "muster": "(?:[Ii]ch\\s+hei(?:ße|sse)|[Mm]ein\\s+[Nn]ame\\s+ist|[Ii]ch\\s+bin\\s+(?:der|die)|[Ee]r\\s+hei(?:ßt|sst)|[Ss]ie\\s+hei(?:ßt|sst)|[Mm]eine?\\s+(?:[Ff]reundin|[Ff]reund|[Ss]chwester|[Bb]ruder|[Ll]ehrerin|[Ll]ehrer|[Mm]utter|[Vv]ater|[Mm]ama|[Pp]apa)\\s+(?:hei(?:ßt|sst)\\s+)?)\\s*(\\p{Lu}[\\p{L}-]+(?:\\s+\\p{Lu}[\\p{L}-]+)?)",
            "schalter": "u",
            "ersetze": 1,
            "treffer": [
                "Ich heiße Nele",
                "mein Name ist Jonas Becker",
                "meine Freundin Mila"
