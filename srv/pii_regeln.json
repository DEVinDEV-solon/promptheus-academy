{
    "fassung": 1,
    "stand": "2026-09-27",
    "hinweis": "Wortgleiche Kopie in der Academy (srv/pii_regeln.json). Wer hier etwas ändert, ändert es dort mit. Muster müssen in PCRE (PHP) und JavaScript gleich wirken: kein possessiver Quantor, keine atomaren Gruppen, \\p{..} nur ohne i-Schalter.",
    "ersatz": "xxx",
    "regeln": [
        {
            "id": "email",
            "art": "hart",
            "titel": "Keine E-Mail-Adressen",
            "text": "Eine E-Mail-Adresse führt direkt zu einer Person. Sie gehört nicht in die Gemeinde.",
            "muster": "[\\p{L}\\p{N}._%+-]+@[\\p{L}\\p{N}.-]+\\.[\\p{L}]{2,}",
            "schalter": "u",
            "treffer": [
                "Schreib mir an nele.b@example.com",
                "kontakt@schule.example"
            ],
            "kein_treffer": [
                "Das @-Zeichen trennt Name und Domain",
                "user@localhost ohne Punkt"
            ]
        },
        {
            "id": "telefon",
            "art": "hart",
            "titel": "Keine Telefon- oder Mobilnummern",
            "text": "Telefonnummern bleiben privat — auch die von Freunden.",
            "muster": "(?<![\\p{L}\\p{N}])(?:\\+\\d{1,3}|00\\d{1,3}|0)[\\s\\/.-]?\\d(?:[\\s\\/.-]?\\d){5,13}(?![\\p{N}])",
            "schalter": "u",
            "treffer": [
                "Ruf an: 0151 23456789",
                "+49 171 1234567",
                "0711/123456"
            ],
            "kein_treffer": [
                "Das kostet 1000 Token",
                "Version 2.0.1",
                "im Jahr 2026"
            ]
        },
        {
            "id": "kreditkarte",
            "art": "hart",
            "titel": "Keine Kartennummern",
            "text": "Kreditkarten- und Kontonummern haben hier nichts verloren.",
            "muster": "(?<![\\p{N}])\\d(?:[ -]?\\d){12,18}(?![\\p{N}])",
            "schalter": "u",
            "pruefung": "luhn",
            "treffer": [
                "Karte 4111 1111 1111 1111",
                "5500-0000-0000-0004"
            ],
            "kein_treffer": [
                "Zahl 1234 5678 9012 3456",
                "Seriennummer 1111111111111"
            ]
        },
        {
            "id": "iban",
            "art": "hart",
            "titel": "Keine Kontonummern (IBAN)",
            "text": "Eine IBAN ist ein Bankkonto. Sie bleibt privat.",
            "muster": "(?<![A-Za-z0-9])[A-Z]{2}\\d{2}(?:[ ]?[A-Z0-9]{4}){3,7}(?:[ ]?[A-Z0-9]{1,3})?(?![A-Za-z0-9])",
            "schalter": "u",
            "treffer": [
                "IBAN DE89 3704 0044 0532 0130 00",
                "DE89370400440532013000"
            ],
            "kein_treffer": [
                "Datei AB12.txt",
                "Modell GPT4 ist neu"
            ]
        },
        {
            "id": "api_schluessel",
            "art": "hart",
            "titel": "Keine Schlüssel und Zugangsdaten",
            "text": "API-Schlüssel, Token und Kennwörter sind wie ein Haustürschlüssel. Wer sie sieht, kann sie benutzen.",
            "muster": "(?:sk-[A-Za-z0-9_-]{16,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{30,}|xox[abpr]-[A-Za-z0-9-]{10,}|eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,})",
            "schalter": "u",
            "treffer": [
                "nimm den hier: ghp_abcdefghijklmnopqrstuvwxyz123456",
                "Token eyJhbGciOiJIUzI1.eyJzdWIiOiIxMjM0.abcdefghijklmn"
            ],
            "kein_treffer": [
                "sk-kurz",
                "Die Skizze ist fertig"
            ]
        },
        {
            "id": "kennwort",
            "art": "hart",
            "titel": "Keine Kennwörter",
            "text": "Ein Kennwort gehört nur dir — nirgendwohin schreiben.",
            "muster": "(?:[Pp]asswor[td]|[Kk]ennwort|[Pp]asscode|PIN|[Pp]in-?[Cc]ode)\\s*(?:ist|lautet|=|:)\\s*(\\S{3,})",
            "schalter": "u",
            "ersetze": 1,
            "treffer": [
                "mein Passwort ist geheim123",
                "PIN: 4711"
            ],
            "kein_treffer": [
                "Ein Kennwort braucht acht Zeichen",
                "Passwort vergessen?"
            ]
        },
        {
            "id": "geburtstag",
            "art": "hart",
            "titel": "Kein Geburtstag und kein Datum",
            "text": "Ein Geburtstag verrät, wer du bist. Lass Daten weg.",
            "muster": "(?<![\\p{N}])(?:\\d{1,2}\\.\\s?\\d{1,2}\\.(?:\\s?(?:19|20)?\\d{2})?|(?:19|20)\\d{2}-\\d{2}-\\d{2}|\\d{1,2}\\.\\s?(?:[Jj]anuar|[Ff]ebruar|[Mm]ärz|[Aa]pril|[Mm]ai|[Jj]uni|[Jj]uli|[Aa]ugust|[Ss]eptember|[Oo]ktober|[Nn]ovember|[Dd]ezember)(?:\\s(?:19|20)\\d{2})?)(?![\\p{N}])",
            "schalter": "u",
            "treffer": [
                "geboren am 12.03.2014",
                "am 3. Mai",
                "2014-03-12"
            ],
            "kein_treffer": [
                "Kapitel 3 und 4",
                "Version 1.2"
            ]
        },
        {
            "id": "alter",
            "art": "hart",
            "titel": "Kein Alter",
            "text": "Wie alt du bist, bleibt bei dir.",
            "muster": "(?:(?:[Ii]ch\\s+bin|[Bb]in|[Ww]erde|[Ww]urde|[Ee]r\\s+ist|[Ss]ie\\s+ist|[Aa]lter:?)\\s+\\d{1,2}(?:\\s*(?:[Jj]ahre?(?:\\s+alt)?|[Jj]\\.?))?|(?<![\\p{N}])\\d{1,2}\\s*(?:[Jj]ahre?\\s+alt|-?[Jj]ährig(?:e[rnms]?)?|[Jj]\\.\\s*alt))(?![\\p{L}\\p{N}])",
            "schalter": "u",
            "treffer": [
                "ich bin 12 Jahre alt",
                "Er ist 9",
                "die 11-jährige",
                "Alter: 13"
            ],
            "kein_treffer": [
                "Das Projekt ist 12 Seiten lang",
                "vor 3 Wochen"
            ]
        },
        {
            "id": "klasse",
            "art": "hart",
            "titel": "Keine Klasse",
            "text": "Deine Klasse macht dich findbar. Lass sie weg.",
            "muster": "(?:(?:[Kk]lasse|[Kk]l\\.|[Jj]ahrgangsstufe|[Jj]ahrgang|[Ss]tufe)\\s*\\d{1,2}\\s?[a-fA-F]?(?![\\p{L}\\p{N}])|(?<![\\p{L}\\p{N}.])(?:[5-9]|1[0-3])\\s?[a-f](?![\\p{L}\\p{N}]))",
            "schalter": "u",
            "treffer": [
                "ich bin in der 5b",
                "Klasse 7a",
                "Jahrgangsstufe 11"
            ],
            "kein_treffer": [
                "Schritt 5 von 9",
                "Seite 10"
            ]
        },
        {
            "id": "anschrift",
            "art": "hart",
            "titel": "Keine Anschrift",
            "text": "Wo jemand wohnt, gehört nicht ins Netz.",
            "muster": "(?:[\\p{L}ß.-]+(?:straße|strasse|str\\.|weg|gasse|platz|allee|ring|damm)\\s*\\d{1,4}\\s?[a-z]?(?![\\p{L}\\p{N}])|(?:PLZ|Postleitzahl)\\s*:?\\s*\\d{5}(?:\\s+\\p{Lu}[\\p{L}-]+)?)",
            "schalter": "u",
            "treffer": [
                "Hauptstraße 12",
                "Am Lindenweg 3a",
                "PLZ 71634"
            ],
            "kein_treffer": [
                "der Weg ist das Ziel",
                "in 12345 Fällen"
            ]
        },
        {
            "id": "soziales_profil",
